<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Nail Art Studio | Premium Nail Art & Beauty Studio</title>
  <meta name="description" content="Nail Art Studio menghadirkan layanan premium manicure, gel polish, nail art, extensions, dan luxury nail treatment dengan desain elegan dan profesional.">
  <meta name="keywords" content="nail art, salon nail art, nail art studio, manicure, gel polish, nail extension">
  <meta name="author" content="Nail Art Studio">

  <meta property="og:title" content="Nail Art Studio | Beautiful Nails, Beautiful You">
  <meta property="og:description" content="Premium nail art studio untuk kuku cantik dan elegan.">
  <meta property="og:type" content="website">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

  <style>
    :root {
      --pink: #e8b8bd;
      --pink-dark: #c98991;
      --pink-light: #f9e9e9;
      --cream: #fffaf6;
      --nude: #ead8cd;
      --rose-gold: #b77b70;
      --brown: #3a2927;
      --brown-light: #705b57;
      --white: #ffffff;
      --border: rgba(58, 41, 39, 0.10);
      --shadow: 0 20px 60px rgba(58, 41, 39, 0.10);
      --radius: 24px;
      --transition: 0.35s ease;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      font-family: "Poppins", sans-serif;
      color: var(--brown);
      background: var(--cream);
      line-height: 1.7;
      overflow-x: hidden;
    }

    img {
      width: 100%;
      display: block;
      object-fit: cover;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
      border: none;
      cursor: pointer;
    }

    .container {
      width: min(1180px, 90%);
      margin: auto;
    }

    .section {
      padding: 110px 0;
    }

    .section-label {
      color: var(--rose-gold);
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 12px;
    }

    .section-title {
      font-family: "Playfair Display", serif;
      font-size: clamp(38px, 5vw, 58px);
      line-height: 1.15;
      font-weight: 500;
      margin-bottom: 20px;
    }

    .section-desc {
      color: var(--brown-light);
      max-width: 650px;
      margin-bottom: 45px;
    }

    .text-center {
      text-align: center;
    }

    .text-center .section-desc {
      margin-left: auto;
      margin-right: auto;
    }

    /* NAVBAR */
    .navbar {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      padding: 22px 0;
      transition: var(--transition);
    }

    .navbar.scrolled {
      background: rgba(255, 250, 246, 0.94);
      backdrop-filter: blur(15px);
      box-shadow: 0 8px 30px rgba(58, 41, 39, 0.08);
      padding: 14px 0;
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: "Playfair Display", serif;
      font-size: 25px;
      font-weight: 600;
      letter-spacing: 1px;
      white-space: nowrap;
    }

    .logo span {
      color: var(--rose-gold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      font-size: 13px;
      font-weight: 500;
      position: relative;
    }

    .nav-links a:not(.nav-btn)::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -7px;
      width: 0;
      height: 1px;
      background: var(--rose-gold);
      transition: var(--transition);
    }

    .nav-links a:not(.nav-btn):hover::after {
      width: 100%;
    }

    .nav-btn,
    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      padding: 14px 25px;
      border-radius: 50px;
      background: var(--brown);
      color: var(--white);
      font-size: 13px;
      font-weight: 500;
      transition: var(--transition);
    }

    .nav-btn:hover,
    .btn:hover {
      background: var(--rose-gold);
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(183, 123, 112, 0.25);
    }

    .btn-light {
      background: rgba(255,255,255,0.9);
      color: var(--brown);
    }

    .btn-outline {
      background: transparent;
      border: 1px solid rgba(58,41,39,.25);
      color: var(--brown);
    }

    .btn-outline:hover {
      color: white;
      border-color: var(--rose-gold);
    }

    .menu-toggle {
      display: none;
      background: none;
      font-size: 24px;
      color: var(--brown);
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(90deg, rgba(255,250,246,.96) 0%, rgba(255,250,246,.82) 42%, rgba(255,250,246,.15) 100%),
        url("https://images.unsplash.com/photo-1604654894610-df63bc536371?auto=format&fit=crop&w=1800&q=90") center/cover;
    }

    .hero-content {
      max-width: 680px;
      padding-top: 80px;
      animation: fadeUp 1s ease both;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      padding: 8px 15px;
      border: 1px solid rgba(183,123,112,.35);
      border-radius: 50px;
      color: var(--rose-gold);
      font-size: 11px;
      letter-spacing: 2px;
      font-weight: 600;
      margin-bottom: 25px;
      background: rgba(255,255,255,.55);
      backdrop-filter: blur(5px);
    }

    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(58px, 8vw, 95px);
      line-height: .98;
      font-weight: 500;
      margin-bottom: 28px;
    }

    .hero h1 span {
      color: var(--rose-gold);
      font-style: italic;
    }

    .hero p {
      color: var(--brown-light);
      font-size: 16px;
      max-width: 560px;
      margin-bottom: 35px;
    }

    .hero-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .hero-decor {
      position: absolute;
      right: 5%;
      bottom: 8%;
      font-family: "Playfair Display", serif;
      font-size: 90px;
      color: rgba(183,123,112,.15);
      transform: rotate(-10deg);
    }

    /* ABOUT */
    .about {
      background: var(--white);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .about-images {
      position: relative;
      min-height: 600px;
    }

    .about-img {
      position: absolute;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .about-img.one {
      width: 72%;
      height: 440px;
      left: 0;
      top: 0;
    }

    .about-img.two {
      width: 55%;
      height: 330px;
      right: 0;
      bottom: 0;
      border: 10px solid white;
    }

    .about-card {
      position: absolute;
      left: 25px;
      bottom: 50px;
      background: white;
      padding: 18px 24px;
      border-radius: 18px;
      box-shadow: var(--shadow);
      z-index: 2;
    }

    .about-card strong {
      display: block;
      font-family: "Playfair Display", serif;
      font-size: 28px;
      color: var(--rose-gold);
    }

    .about-card small {
      color: var(--brown-light);
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
      margin-top: 40px;
    }

    .stat {
      padding: 22px;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: var(--cream);
    }

    .stat strong {
      display: block;
      font-family: "Playfair Display", serif;
      color: var(--rose-gold);
      font-size: 30px;
    }

    .stat span {
      font-size: 12px;
      color: var(--brown-light);
    }

    /* SERVICES */
    .services {
      background: var(--pink-light);
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .service-card {
      background: white;
      padding: 35px 30px;
      border-radius: var(--radius);
      border: 1px solid transparent;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }

    .service-card:hover {
      transform: translateY(-8px);
      border-color: var(--nude);
      box-shadow: var(--shadow);
    }

    .service-icon {
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      background: var(--pink-light);
      color: var(--rose-gold);
      border-radius: 50%;
      font-size: 21px;
      margin-bottom: 22px;
    }

    .service-card h3 {
      font-family: "Playfair Display", serif;
      font-size: 25px;
      margin-bottom: 12px;
    }

    .service-card p {
      color: var(--brown-light);
      font-size: 13px;
      margin-bottom: 25px;
    }

    .service-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .price {
      color: var(--rose-gold);
      font-size: 13px;
      font-weight: 600;
    }

    .small-btn {
      background: var(--brown);
      color: white;
      padding: 9px 15px;
      border-radius: 50px;
      font-size: 11px;
    }

    /* PORTFOLIO */
    .portfolio {
      background: var(--cream);
    }

    .filters {
      display: flex;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }

    .filter-btn {
      padding: 10px 20px;
      border-radius: 50px;
      background: white;
      border: 1px solid var(--border);
      color: var(--brown-light);
      font-size: 12px;
      transition: var(--transition);
    }

    .filter-btn.active,
    .filter-btn:hover {
      background: var(--brown);
      color: white;
    }

    .portfolio-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .portfolio-item {
      position: relative;
      height: 360px;
      border-radius: 20px;
      overflow: hidden;
      cursor: pointer;
    }

    .portfolio-item img {
      height: 100%;
      transition: .6s ease;
    }

    .portfolio-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: flex-end;
      padding: 25px;
      color: white;
      background: linear-gradient(transparent 35%, rgba(30,20,18,.75));
      opacity: 0;
      transition: var(--transition);
    }

    .portfolio-item:hover img {
      transform: scale(1.07);
    }

    .portfolio-item:hover .portfolio-overlay {
      opacity: 1;
    }

    .portfolio-overlay h3 {
      font-family: "Playfair Display", serif;
      font-size: 23px;
    }

    .portfolio-item.hidden {
      display: none;
    }

    /* PRICE */
    .pricing {
      background: var(--white);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 25px;
      align-items: stretch;
    }

    .price-card {
      padding: 40px 32px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--cream);
      position: relative;
    }

    .price-card.featured {
      background: var(--brown);
      color: white;
      transform: translateY(-12px);
      box-shadow: var(--shadow);
    }

    .price-card h3 {
      font-family: "Playfair Display", serif;
      font-size: 28px;
      margin-bottom: 25px;
    }

    .price-list {
      list-style: none;
      margin-bottom: 30px;
    }

    .price-list li {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
      font-size: 12px;
    }

    .price-card.featured .price-list li {
      border-color: rgba(255,255,255,.15);
    }

    .price-list span:last-child {
      color: var(--rose-gold);
      font-weight: 600;
      white-space: nowrap;
    }

    .featured .price-list span:last-child {
      color: var(--pink);
    }

    /* WHY */
    .why {
      background: var(--pink-light);
    }

    .why-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 15px;
    }

    .why-card {
      background: white;
      text-align: center;
      padding: 30px 18px;
      border-radius: 20px;
      transition: var(--transition);
    }

    .why-card:hover {
      transform: translateY(-7px);
    }

    .why-card i {
      font-size: 27px;
      color: var(--rose-gold);
      margin-bottom: 18px;
    }

    .why-card h3 {
      font-size: 13px;
      line-height: 1.4;
    }

    /* BEFORE AFTER */
    .transformation {
      background: var(--white);
    }

    .transformation-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .comparison {
      position: relative;
      height: 440px;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .comparison img {
      height: 100%;
    }

    .comparison-label {
      position: absolute;
      top: 20px;
      padding: 7px 13px;
      border-radius: 50px;
      background: rgba(255,255,255,.9);
      font-size: 11px;
      font-weight: 600;
    }

    .comparison .before {
      left: 20px;
    }

    .comparison .after {
      right: 20px;
      background: var(--brown);
      color: white;
    }

    /* REVIEWS */
    .reviews {
      background: var(--cream);
    }

    .review-wrapper {
      max-width: 780px;
      margin: auto;
      position: relative;
    }

    .review-card {
      background: white;
      padding: 50px;
      border-radius: var(--radius);
      text-align: center;
      box-shadow: var(--shadow);
      display: none;
    }

    .review-card.active {
      display: block;
      animation: fadeUp .5s ease;
    }

    .stars {
      color: #d59b43;
      letter-spacing: 4px;
      margin-bottom: 20px;
    }

    .review-text {
      font-family: "Playfair Display", serif;
      font-size: 25px;
      line-height: 1.5;
      margin-bottom: 25px;
    }

    .review-user {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }

    .review-user img {
      width: 48px;
      height: 48px;
      border-radius: 50%;
    }

    .review-user strong {
      display: block;
      font-size: 13px;
    }

    .review-user span {
      font-size: 11px;
      color: var(--brown-light);
    }

    .review-controls {
      display: flex;
      justify-content: center;
      gap: 10px;
      margin-top: 25px;
    }

    .review-control {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: white;
      color: var(--brown);
      border: 1px solid var(--border);
    }

    /* INSTAGRAM */
    .instagram {
      background: white;
    }

    .instagram-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
    }

    .instagram-item {
      aspect-ratio: 1;
      overflow: hidden;
      position: relative;
    }

    .instagram-item img {
      height: 100%;
      transition: .5s;
    }

    .instagram-item:hover img {
      transform: scale(1.08);
      filter: brightness(.75);
    }

    /* BOOKING */
    .booking {
      padding: 100px 0;
      background:
        linear-gradient(rgba(58,41,39,.85), rgba(58,41,39,.85)),
        url("https://images.unsplash.com/photo-1607779097040-26e80aa78e66?auto=format&fit=crop&w=1800&q=85") center/cover;
      color: white;
      text-align: center;
    }

    .booking .section-title {
      max-width: 750px;
      margin-left: auto;
      margin-right: auto;
    }

    .booking p {
      max-width: 600px;
      margin: 0 auto 30px;
      color: rgba(255,255,255,.75);
    }

    /* CONTACT */
    .contact {
      background: var(--cream);
    }

    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
    }

    .contact-info {
      display: grid;
      gap: 18px;
    }

    .contact-item {
      display: flex;
      align-items: flex-start;
      gap: 17px;
      padding: 20px;
      background: white;
      border-radius: 18px;
    }

    .contact-icon {
      width: 45px;
      height: 45px;
      min-width: 45px;
      border-radius: 50%;
      background: var(--pink-light);
      display: grid;
      place-items: center;
      color: var(--rose-gold);
    }

    .contact-item strong {
      display: block;
      font-size: 13px;
      margin-bottom: 3px;
    }

    .contact-item span,
    .contact-item a {
      color: var(--brown-light);
      font-size: 12px;
    }

    .map {
      min-height: 100%;
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
    }

    .map iframe {
      width: 100%;
      height: 100%;
      min-height: 420px;
      border: 0;
    }

    /* FOOTER */
    footer {
      background: #251b19;
      color: white;
      padding: 70px 0 25px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 40px;
      padding-bottom: 50px;
    }

    .footer-logo {
      font-family: "Playfair Display", serif;
      font-size: 30px;
      margin-bottom: 18px;
    }

    .footer-logo span {
      color: var(--pink);
    }

    .footer-about {
      color: rgba(255,255,255,.55);
      font-size: 12px;
      max-width: 300px;
    }

    .footer-column h4 {
      font-size: 13px;
      margin-bottom: 18px;
    }

    .footer-column ul {
      list-style: none;
      display: grid;
      gap: 10px;
    }

    .footer-column a,
    .footer-column li {
      color: rgba(255,255,255,.55);
      font-size: 11px;
    }

    .footer-column a:hover {
      color: var(--pink);
    }

    .socials {
      display: flex;
      gap: 10px;
      margin-top: 22px;
    }

    .socials a {
      width: 38px;
      height: 38px;
      border: 1px solid rgba(255,255,255,.15);
      border-radius: 50%;
      display: grid;
      place-items: center;
      transition: var(--transition);
    }

    .socials a:hover {
      background: var(--pink);
      color: var(--brown);
    }

    .copyright {
      padding-top: 25px;
      border-top: 1px solid rgba(255,255,255,.1);
      color: rgba(255,255,255,.4);
      text-align: center;
      font-size: 10px;
    }

    /* FLOATING WHATSAPP */
    .whatsapp {
      position: fixed;
      right: 22px;
      bottom: 22px;
      width: 58px;
      height: 58px;
      display: grid;
      place-items: center;
      background: #25d366;
      color: white;
      border-radius: 50%;
      font-size: 28px;
      z-index: 900;
      box-shadow: 0 10px 30px rgba(37,211,102,.35);
      animation: pulse 2s infinite;
    }

    /* BACK TOP */
    .back-top {
      position: fixed;
      right: 24px;
      bottom: 95px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--brown);
      color: white;
      display: grid;
      place-items: center;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition);
      z-index: 899;
    }

    .back-top.show {
      opacity: 1;
      visibility: visible;
    }

    /* LIGHTBOX */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(25,17,16,.92);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 2000;
      opacity: 0;
      visibility: hidden;
      transition: var(--transition);
      padding: 30px;
    }

    .lightbox.active {
      opacity: 1;
      visibility: visible;
    }

    .lightbox img {
      max-width: 850px;
      max-height: 85vh;
      width: auto;
      border-radius: 15px;
      box-shadow: 0 20px 70px rgba(0,0,0,.4);
    }

    .lightbox-close {
      position: absolute;
      top: 25px;
      right: 30px;
      color: white;
      font-size: 35px;
      background: none;
    }

    /* REVEAL */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: .8s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes pulse {
      0%, 100% {
        box-shadow: 0 10px 30px rgba(37,211,102,.35);
      }
      50% {
        box-shadow: 0 10px 40px rgba(37,211,102,.65);
      }
    }

    /* RESPONSIVE */
    @media (max-width: 1000px) {
      .nav-links {
        gap: 17px;
      }

      .why-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .footer-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 800px) {
      .section {
        padding: 80px 0;
      }

      .menu-toggle {
        display: block;
      }

      .nav-links {
        position: absolute;
